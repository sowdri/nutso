{
  "git": {
    "requireBranch": "master"
  },
  "hooks": {
    "before:init": ["git pull", "pnpm run test"],
    "after:bump": "npx auto-changelog -p"
  },
  "github": {
    "release": true,
    "tokenRef": "PERSONAL_GITHUB_TOKEN",
    "comments": {
      "submit": true
    }
  },
  "npm": {
    "publish": false
  }
}
