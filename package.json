  "devDependencies": {
    "@parcel/packager-ts": "^2.14.4",
    "@parcel/transformer-typescript-types": "^2.14.4",
    "@swc/core": "^1.4.3",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "parcel": "^2.14.4",
    "release-it": "^18.1.2",
    "typescript": "^5.8.3"
